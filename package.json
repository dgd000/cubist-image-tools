{
  "name": "cubist-image-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-local image resizing, cropping, and format conversion by CubistAI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgd000/cubist-image-tools.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test --project=core --project=chromium",
    "test:unit": "playwright test --project=core",
    "test:browser": "playwright test --project=chromium",
    "test:browsers": "playwright test --project=chromium --project=firefox --project=webkit"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "typescript": "~5.9.3",
    "vite": "~8.3.5"
  }
}
